{
  "purpose": "新民主主义革命阶段与83个节点、会议的对应及边界说明。",
  "stageDimensionNote": "革命阶段与抗日历史专题是两种维度。土地革命1927—1937期间同时有1931—1937局部抗战和抗日救亡；全民族抗战阶段从1937年七七事变起。",
  "sourceBasis": [
    {
      "book": "core",
      "page": 231,
      "detail": "统一战线对照表明确1924—1927大革命、1927—1937土地革命、1937—1945全面抗日战争、1945—1949解放战争。"
    },
    {
      "book": "legLower",
      "page": 9,
      "detail": "八七、古田、遵义会议的时间与历史作用。"
    },
    {
      "book": "legLower",
      "page": 11,
      "detail": "六届六中全会、六届七中全会、七大。"
    },
    {
      "book": "legLower",
      "page": 12,
      "detail": "七大续、1949七届二中和1950七届三中分开。"
    },
    {
      "book": "legLower",
      "page": 20,
      "detail": "《论反对日本帝国主义的策略》列土地革命阶段。"
    },
    {
      "book": "legLower",
      "page": 21,
      "detail": "哲学两论和其他文献明确列全民族抗战阶段。"
    },
    {
      "book": "legLower",
      "page": 22,
      "detail": "《论联合政府》在抗战篇，《晋绥讲话》《人民民主专政》列解放及建国后篇，具体按发表时间区分。"
    }
  ],
  "stages": [
    {
      "id": "founding",
      "name": "五四运动与党的创建时期",
      "shortName": "五四与建党",
      "range": "1919—1923年",
      "parentPeriod": "revolution",
      "description": "五四运动、马克思主义传播、建党与革命纲领探索；国共合作的准备放在这一阶段，并与下一阶段关联。"
    },
    {
      "id": "greatRevolution",
      "name": "大革命时期",
      "shortName": "大革命",
      "range": "1924—1927年7月",
      "parentPeriod": "revolution",
      "description": "以第一次国共合作正式形成为开端，国民革命兴起、北伐与大革命失败；1927年按月份及事件性质划界。",
      "aliases": [
        "国民革命时期",
        "第一次国内革命战争时期"
      ]
    },
    {
      "id": "landRevolution",
      "name": "土地革命战争时期",
      "shortName": "土地革命",
      "range": "1927年大革命失败后—1937年7月全面抗战前",
      "compactRange": "1927—1937年",
      "parentPeriod": "revolution",
      "description": "大革命失败后探索武装斗争、农村革命道路、土地革命和革命政权；1931年后同时存在局部抗战与抗日救亡，不能因此把该阶段等同于全民族抗战。",
      "aliases": [
        "土地革命时期",
        "第二次国内革命战争时期"
      ]
    },
    {
      "id": "resistance",
      "name": "全民族抗日战争时期",
      "shortName": "抗日战争",
      "range": "1937年7月—1945年8月",
      "parentPeriod": "revolution",
      "description": "此处采用新民主主义革命的阶段分期，七七事变后进入全民族抗战；中国人民抗日战争整体从1931年起算，局部抗战节点仍可按抗日专题串联。",
      "aliases": [
        "抗日战争时期",
        "全面抗日战争时期",
        "全民族抗战时期"
      ]
    },
    {
      "id": "liberation",
      "name": "解放战争时期",
      "shortName": "解放战争",
      "range": "1945年8月—1949年9月",
      "parentPeriod": "revolution",
      "description": "包含抗战胜利后的和平民主建国努力、全面内战与解放战争，以及1949年新中国成立前的筹备，不只指1946年6月后的全面内战。",
      "aliases": [
        "第三次国内革命战争时期"
      ]
    }
  ],
